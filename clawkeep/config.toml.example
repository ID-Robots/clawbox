# /etc/clawkeep/config.toml
#
# Copy this to /etc/clawkeep/config.toml and edit. Fields are documented
# in section 7 of the design doc (clawkeep-plan.md).

# Portal endpoint. Change once the canonical domain migrates.
server = "https://clawbox.com"

# How often the systemd timer fires. Keep in sync with the timer unit.
schedule = "daily"  # daily | weekly | manual

# WHAT gets backed up depends on the device edition, resolved from the
# root-owned /etc/clawbox/edition.env (see clawkeep/agent.py):
#
#   openclaw — delegated to `openclaw backup create`: OpenClaw state,
#              config, credentials, sessions and (optionally) workspaces.
#              See https://docs.openclaw.ai/cli/backup.
#   hermes   — built into the daemon (clawkeep/hermes.py), no second CLI:
#              ~/.hermes config.yaml, .env, state.db, memories, skills,
#              plugins, hooks, cron, pairing, plus the shared identity at
#              ~/.clawbox/agent-identity. The agent checkout, the venv and
#              every cache are deliberately left out — see that module's
#              docstring for the full list and the reasoning.
#
# The [openclaw] table below is read on BOTH editions. `only_config` and
# `verify` apply to either backend; `binary` and `include_workspace` are
# OpenClaw-only and ignored on Hermes.
[openclaw]
binary = "openclaw"          # absolute path or PATH-resolvable name
include_workspace = true     # set false to skip ~/.openclaw/workspace
only_config = false          # set true to back up only the active JSON config file
verify = true                # verify the archive after writing (each backend
                             # checks its own format)
output_dir = ""              # blank → tmpdir per run (cleaned up on exit)

[heartbeat]
idle_interval_hours = 24
