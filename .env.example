ALLOW_INSECURE_CONTROL_UI=true

# Google Gemini CLI OAuth credentials (public installed-app client)
# These are set automatically by install.sh — no manual config needed.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: enables ClawBox AI as an automatic OpenClaw fallback model.
# CLAWBOX_AI_API_KEY=

# Optional: connect the llama.cpp local provider to a running llama-server.
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# LLAMACPP_MODEL=gemma4-e2b-it-q4_0
# LLAMACPP_HF_REPO=gguf-org/gemma-4-e2b-it-gguf
# LLAMACPP_HF_FILE=gemma-4-e2b-it-edited-q4_0.gguf
# LLAMACPP_BIN=/usr/local/bin/llama-server
# LLAMACPP_CONTEXT_WINDOW=131072
# LLAMACPP_CACHE_TYPE_K=q4_0
# LLAMACPP_CACHE_TYPE_V=q4_0
# Optional override for OpenClaw's output budget. If unset, ClawBox uses the
# full llama.cpp context window instead of a smaller app-level cap.
# LLAMACPP_MAX_TOKENS=131072

# Memory-search embedder (Qwen3-Embedding-0.6B on llama.cpp, clawbox-embed.service).
# EMBED_BASE_URL=http://127.0.0.1:8081/v1
# EMBED_MODEL=qwen3-embedding-0.6b
# EMBED_HF_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
# EMBED_HF_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
# -c/-b/-ub as one number: 1024 default; 2048 for mostly-CJK notes (~0.6 GB more).
# EMBED_BATCH=1024
# 99 = whole model on the GPU; 0 = CPU only (queries faster, indexing 13x slower).
# EMBED_N_GPU_LAYERS=99
# EMBED_CACHE_TYPE_K=q8_0
# EMBED_CACHE_TYPE_V=q8_0
# Refuse to wake the embedder below this much MemAvailable (MB); 0 disables.
# EMBED_WAKE_MIN_AVAILABLE_MB=2300

# Optional: Hermes dashboard proxy (scripts/hermes-dashboard-proxy.js) upstream
# timeouts, in milliseconds. Each is armed only for the phase where silence
# means the upstream is stuck; 0 disables one. Defaults shown.
# HERMES_DASH_UPSTREAM_TIMEOUT_MS=30000   # request sent -> first response byte
# HERMES_DASH_LOGIN_TIMEOUT_MS=10000      # absolute deadline for the SSO login
# HERMES_DASH_WS_TIMEOUT_MS=15000         # TCP connect + WebSocket handshake
