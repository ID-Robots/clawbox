{
  "manifest_version": 3,
  "name": "ClawBox Vault",
  "short_name": "Vault",
  "version": "0.2.0",
  "description": "Fills and saves logins from the ClawBox Vault service running on this machine.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/vault.png",
    "32": "icons/vault.png",
    "48": "icons/vault.png",
    "128": "icons/vault.png"
  },
  "action": {
    "default_title": "ClawBox Vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/vault.png",
      "32": "icons/vault.png"
    }
  },
  "background": {
    "service_worker": "build/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["build/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "scripting", "alarms", "offscreen", "clipboardWrite"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'self' http://127.0.0.1:4796; img-src 'self'; style-src 'self'"
  }
}
