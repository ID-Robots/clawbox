[Unit]
Description=ClawBox Root Update Step (%i)

[Service]
Type=oneshot
EnvironmentFile=-/etc/clawbox/network.env
# The device SKU. Without it every updater-run step evaluated
# is_hermes_edition() as false — and UPDATE_STEPS includes openclaw_install,
# openclaw_patch and gateway_setup, so an in-app update reinstalled and STARTED
# the OpenClaw gateway on a Hermes appliance. install.sh also reads this file
# directly (it is the authority, not this environment), but exporting it here
# keeps anything the steps shell out to consistent with the resolved edition.
EnvironmentFile=-/etc/clawbox/edition.env
# Root-owned entrypoint, outside every clawbox-writable directory. Pointing
# ExecStart straight at /home/clawbox/clawbox/install.sh meant the clawbox user
# — who the web server, the in-UI terminal and the agent's shell all run as —
# could edit the file root was about to execute, turning a scoped
# clawbox-root-update@ sudoers grant into a one-step local root. The dispatcher
# closes that: it never execs the tree at all. It runs a ROOT-OWNED MIRROR of
# install.sh, scripts/ and config/ (/var/lib/clawbox/root-exec-mirror), restaged
# only from a tree that still matches the root-owned sha256 record in
# /etc/clawbox — which is what lets the self-updating family (bootstrap_updater,
# post_update, rebuild_reboot) be exempt from that record without root reading a
# file clawbox can write, since an update legitimately rewrites the recorded
# files. It also validates %i (systemd starts whatever instance name it is
# handed, whoever reached it) and only lets the update family run install.sh's
# git-fetch/reset self-update. TASK-445, TASK-733 (docs/root-exec-mirror.md).
ExecStart=/usr/local/libexec/clawbox/clawbox-root-step.sh %i
# 30 min was not enough for llamacpp_install on a cold box: that step builds
# llama.cpp from source with CUDA on a 6-core Jetson Orin AND downloads the
# multi-GB Gemma 4 GGUF. systemd killed the unit mid-build, so "Provisioning
# offline Gemma 4" hung until it failed. Other steps finish in seconds — this
# is a ceiling, not a wait, so raising it costs nothing.
TimeoutStartSec=7200
# Every line a step prints is kept. The update screen's raw log is this unit's
# journal (src/lib/update-raw-log.ts), and journald's default per-service rate
# limit (10000 messages per 30 s) dropped a rebuild's build output by the
# thousand ("Suppressed 1147 messages from
# clawbox-root-update@rebuild_reboot.service", measured on a lab board,
# TASK-2428). Not `LogRateLimitIntervalSec=0`: systemd hands journald a unit's
# limit only when it is above zero, so 0 means "journald's default", not "off".
# A million lines in any one second is more than any step prints or journald
# takes in, so nothing is dropped; a step's output is bounded by the step.
# install.sh (refresh_root_update_log_limit) also installs these two lines as a
# drop-in before an update's rebuild, which starts under whatever limit systemd
# had loaded. Keep them positive.
LogRateLimitIntervalSec=1s
LogRateLimitBurst=1000000
