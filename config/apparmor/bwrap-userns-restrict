# ClawBox: let bubblewrap build its sandbox on a box that restricts
# unprivileged user namespaces (Ubuntu 23.10+,
# kernel.apparmor_restrict_unprivileged_userns=1).
#
# This is upstream AppArmor's own extras/bwrap-userns-restrict at abi 4.0:
# bwrap itself may create a user namespace and hold capabilities INSIDE it
# (it needs CAP_NET_ADMIN there to bring up the sandbox's loopback), and
# everything bwrap starts is stacked with unpriv_bwrap, which denies every
# capability — so bwrap cannot be used to step around the restriction.
#
# Why ClawBox ships it: a read-only Codex coding run (a team's planner or
# reviewer, src/lib/coding-codex.ts) is fenced by Codex's read-only sandbox,
# which is /usr/bin/bwrap with --unshare-net. Without this profile every
# command fails with
# "bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted".
#
# Installed by ensure_bwrap_userns_profile (install.sh and install-x64.sh) to
# /etc/apparmor.d/bwrap-userns-restrict and loaded with apparmor_parser -r —
# only where /usr/bin/bwrap exists, the restriction is on, and no other
# profile already attaches to bwrap. The sysctl itself is never changed.
# The first line of this file is how a later run knows it is ClawBox's own.
# Editing anything here means updating the sha256 pin in install-x64.sh; the
# unit test says so.

abi <abi/4.0>,

include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  allow pix /** -> &bwrap//&unpriv_bwrap,

  include if exists <local/bwrap-userns-restrict>
}

profile unpriv_bwrap flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  allow pix /** -> &unpriv_bwrap,

  audit deny capability,

  include if exists <local/unpriv_bwrap>
}
