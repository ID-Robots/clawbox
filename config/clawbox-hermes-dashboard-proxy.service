[Unit]
Description=ClawBox Hermes Dashboard Auth Proxy (LAN :8090, clawbox_session-gated)
After=clawbox-hermes-dashboard.service clawbox-setup.service
Wants=clawbox-hermes-dashboard.service

[Service]
Type=simple
User=clawbox
WorkingDirectory=/home/clawbox/clawbox
Environment=HOME=/home/clawbox
Environment=CLAWBOX_ROOT=/home/clawbox/clawbox
Environment=HERMES_DASH_PROXY_PORT=8090
ExecStart=/usr/bin/node /home/clawbox/clawbox/scripts/hermes-dashboard-proxy.js
Restart=always
RestartSec=3

# ── Sandboxing ─────────────────────────────────────────────────────────────
# This process only READS (the session secret, the dashboard password) and
# forwards TCP to 127.0.0.2:9119, so it can be locked down harder than the
# dashboard itself. ProtectSystem=full rather than strict so a future need to
# write under /home doesn't turn into a silent read-only failure.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
