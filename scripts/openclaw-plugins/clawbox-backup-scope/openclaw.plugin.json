{
  "id": "clawbox-backup-scope",
  "name": "ClawBox backup scope",
  "description": "Tells OpenClaw backups they can leave out the box's own backup archives in backups/, while keeping the originals openclaw doctor moved there.",
  "activation": { "onStartup": true },
  "configSchema": { "type": "object", "additionalProperties": false },
  "backupResources": [
    { "disposition": "regenerable", "scope": "state", "relativePath": "backups" },
    { "disposition": "include", "scope": "state", "relativePath": "backups/tools-md-migration" },
    { "disposition": "include", "scope": "state", "relativePath": "backups/heartbeat-migration" }
  ]
}
